# =============================================================================
# Clipper Environment Configuration
# Copy this file to .env and fill in real values. NEVER commit .env.
# =============================================================================

# --- Application ---
APP_ENV=development
APP_NAME=Clipper
LOG_LEVEL=INFO
BACKEND_CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# --- Security (generate strong random values in production) ---
# Generate JWT secret: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-in-production-use-64-char-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Generate Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Optional: enable a local dev-only quick-login route (MUST be false in production)
ENABLE_DEV_AUTH=false

# --- Database (PostgreSQL) ---
POSTGRES_USER=clipper
POSTGRES_PASSWORD=clipper_dev_password
POSTGRES_DB=clipper
DATABASE_URL=postgresql+psycopg://clipper:clipper_dev_password@postgres:5432/clipper

# --- Queue / Broker (Redis + Celery) ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- Google OAuth & YouTube Data API v3 (Read-only scope only in Phase 1) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
YOUTUBE_CONNECT_REDIRECT_URI=http://localhost:8000/api/auth/youtube/callback
# API key for public YouTube Data API v3 metadata/license checks (videos.list)
YOUTUBE_API_KEY=

# --- Media Storage & Clipping Engine ---
STORAGE_ROOT=./storage
CLIP_ENGINE=stub
MAX_VIDEO_DURATION_SEC=7200
DEFAULT_CLIP_COUNT=3
DEFAULT_CLIP_DURATION_SEC=30

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000

